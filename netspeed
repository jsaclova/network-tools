#!/bin/bash

echo "============================================================"
echo "          🚀 유/무선 네트워크 선택형 인터넷 속도 측정"
echo "============================================================"

# 1. speedtest-cli 설치 여부 검사
if ! command -v speedtest-cli &> /dev/null; then
    echo " ❌ 오류: speedtest-cli 도구가 설치되어 있지 않습니다."
    echo " 💡 해결 방법: 아래 명령어로 설치 후 다시 실행하세요:"
    echo "    brew install speedtest-cli"
    echo "============================================================"
    exit 1
fi

# 2. 하드웨어 장치명 추출
WIFI_DEV=$(networksetup -listallhardwareports 2>/dev/null | awk '/Wi-Fi/{grep=1; next} grep && /Device:/{print $2; grep=0}')
ETHER_DEVS=$(networksetup -listallhardwareports 2>/dev/null | awk '/Ethernet|LAN|Thunderbolt|USB/{grep=1; next} grep && /Device:/{print $2; grep=0}')
[ -z "$ETHER_DEVS" ] && ETHER_DEVS=$(ifconfig -l | tr ' ' '\n' | grep -E '^en[0-9]+' | grep -v "^$WIFI_DEV$")

# 유선 장치 중 활성화된 것 하나 선택
ETHER_DEV=""
for dev in $ETHER_DEVS; do
    if ifconfig "$dev" 2>/dev/null | grep -q "status: active"; then
        ETHER_DEV="$dev"
        break
    fi
done

# 3. 사용자 선택 메뉴 출력
echo " 📊 측정할 네트워크 장치를 선택해 주세요."
echo "  [1] 유선 이더넷 (LAN)"
echo "  [2] 무선 와이파이 (Wi-Fi)"
echo "------------------------------------------------------------"
read -p " 👉 번호 입력 (1 또는 2): " CHOICE
echo "------------------------------------------------------------"

TARGET_IF=""
TARGET_NAME=""

case "$CHOICE" in
    1)
        TARGET_IF="$ETHER_DEV"
        TARGET_NAME="유선 이더넷"
        if [ -z "$TARGET_IF" ] || ! ifconfig "$TARGET_IF" 2>/dev/null | grep -q "status: active"; then
            echo " ❌ 오류: 현재 연결된 유선 이더넷(LAN) 장치가 없거나 선이 뽑혀 있습니다."
            echo "============================================================"
            exit 1
        fi
        ;;
    2)
        TARGET_IF="$WIFI_DEV"
        TARGET_NAME="무선 와이파이"
        if [ -z "$TARGET_IF" ] || ! ifconfig "$TARGET_IF" 2>/dev/null | grep -q "status: active"; then
            echo " ❌ 오류: 현재 무선 와이파이(Wi-Fi)가 켜져 있지 않거나 연결되지 않았습니다."
            echo "============================================================"
            exit 1
        fi
        ;;
    *)
        echo " ❌ 오류: 잘못된 번호입니다. 1번 또는 2번을 입력해 주세요."
        echo "============================================================"
        exit 1
        ;;
esac

# 4. 기본 라우팅 정보 백업
ORIG_GW=$(route -n get default 2>/dev/null | awk '/gateway:/ {print $2}')
ORIG_IF=$(route -n get default 2>/dev/null | awk '/interface:/ {print $2}')

# 5. 속도 측정 실행
echo " ⏳ ${TARGET_NAME} (${TARGET_IF}) 속도 측정 중... (약 15~20초 소요)"

# 해당 인터페이스로 라우팅 강제 전환 (측정용 임시 설정)
sudo route -q change default -interface "$TARGET_IF" 2>/dev/null

# speedtest 실행
RESULT=$(speedtest-cli --simple 2>/dev/null)

# 라우팅 원래대로 원복 (인터넷 먹통 방지를 위해 필수 수행)
if [ ! -z "$ORIG_GW" ]; then
    sudo route -q change default "$ORIG_GW" 2>/dev/null
else
    sudo route -q change default -interface "$ORIG_IF" 2>/dev/null
fi

# 6. 결과 출력
echo "------------------------------------------------------------"
if [ -z "$RESULT" ]; then
    echo " ❌ 측정 실패: 네트워크 응답이 없거나 테스트 서버에 연결할 수 없습니다."
else
    PING=$(echo "$RESULT" | awk '/Ping:/ {print $2 " " $3}')
    DL=$(echo "$RESULT" | awk '/Download:/ {print $2 " Mbps"}')
    UL=$(echo "$RESULT" | awk '/Upload:/ {print $2 " Mbps"}')
    
    echo "  📊 [ ${TARGET_NAME} 측정 결과 ]"
    echo "------------------------------------------------------------"
    printf "  %-12s : %s\n" "지연 시간(Ping)" "$PING"
    printf "  %-12s : %s\n" "다운로드 속도" "$DL"
    printf "  %-12s : %s\n" "업로드 속도" "$UL"
fi
echo "============================================================"
