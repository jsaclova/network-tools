#!/bin/bash

echo "============================================================"
echo "          🚀 유/무선 네트워크 선택형 인터넷 속도 측정"
echo "============================================================"

# 1. speedtest-cli 설치 여부 검사
if ! command -v speedtest-cli &> /dev/null; then
    echo " ❌ 오류: speedtest-cli 도구가 설치되어 있지 않습니다."
    echo " 💡 해결 방법: 아래 명령어로 설치 후 다시 실행하세요:"
    echo "    brew install speedtest-cli"
    echo "============================================================"
    exit 1
fi

# 2. 하드웨어 서비스 이름 및 장치 ID 파싱
WIFI_DEV=$(networksetup -listallhardwareports 2>/dev/null | awk '/Wi-Fi/{grep=1; next} grep && /Device:/{print $2; grep=0}')
WIFI_SERVICE=$(networksetup -listallnetworkservices 2>/dev/null | grep -E "Wi-Fi|Wi-Fi 1|Wi-Fi 2" | head -n 1)

# 활성화된 유선 이더넷 서비스 찾기
ETHER_SERVICE=""
ETHER_SERVICES=$(networksetup -listallnetworkservices 2>/dev/null | grep -E "Ethernet|LAN|Thunderbolt|USB")
for service in $ETHER_SERVICES; do
    dev=$(networksetup -listallhardwareports 2>/dev/null | xargs -I {} networksetup -listnetworkserviceorder | grep -A 1 "$service" | grep "Device:" | awk '{print $2}')
    if [ ! -z "$dev" ] && ifconfig "$dev" 2>/dev/null | grep -q "status: active"; then
        ETHER_SERVICE="$service"
        ETHER_DEV="$dev"
        break
    fi
done

# 3. 사용자 선택 메뉴 출력
echo " 📊 측정할 네트워크 장치를 선택해 주세요."
echo "  유선 이더넷 (LAN)"
echo "  무선 와이파이 (Wi-Fi)"
echo "------------------------------------------------------------"
read -p " 👉 번호 입력 (1 또는 2): " CHOICE
echo "------------------------------------------------------------"

case "$CHOICE" in
    1)
        if [ -z "$ETHER_SERVICE" ] || [ -z "$ETHER_DEV" ]; then
            echo " ❌ 오류: 유선 이더넷 랜선이 뽑혀있거나 장치가 활성화되어 있지 않습니다."
            echo "============================================================"
            exit 1
        fi
        
        echo " ⏳ 유선 이더넷 ($ETHER_DEV) 속도 측정 중..."
        
        # 와이파이가 켜져 있다면 잠시 끄기 (라우팅 충돌 방지)
        WIFI_WAS_ON=0
        if [ ! -z "$WIFI_DEV" ] && networksetup -getairportpower "$WIFI_DEV" 2>/dev/null | grep -q "On"; then
            WIFI_WAS_ON=1
            networksetup -setairportpower "$WIFI_DEV" off &>/dev/null
        fi
        
        RESULT=$(speedtest-cli --simple 2>/dev/null)
        
        # 원복
        if [ "$WIFI_WAS_ON" -eq 1 ]; then
            networksetup -setairportpower "$WIFI_DEV" on &>/dev/null
        fi
        TARGET_NAME="유선 이더넷 (LAN)"
        ;;
        
    2)
        if [ -z "$WIFI_SERVICE" ] || [ -z "$WIFI_DEV" ]; then
            echo " ❌ 오류: 시스템에서 무선 와이파이(Wi-Fi) 장치를 찾을 수 없습니다."
            echo "============================================================"
            exit 1
        fi
        
        if ! ifconfig "$WIFI_DEV" 2>/dev/null | grep -q "status: active"; then
            echo " ❌ 오류: Wi-Fi가 꺼져있거나 와이파이 공유기에 연결되지 않았습니다."
            echo "============================================================"
            exit 1
        fi
        
        echo " ⏳ 무선 와이파이 ($WIFI_DEV) 속도 측정 중..."
        
        # [핵심 패치] 유선 이더넷이 연결되어 있다면 잠시 비활성화하여 와이파이 경로를 강제 독점합니다.
        ETHER_WAS_ACTIVE=0
        if [ ! -z "$ETHER_SERVICE" ]; then
            ETHER_WAS_ACTIVE=1
            # sudo 없이 특정 네트워크 서비스를 잠시 내리는 맥 전용 명령어
            networksetup -setnetworkserviceenabled "$ETHER_SERVICE" off &>/dev/null
            # 잠시 라우팅이 새로고침될 수 있도록 1초 대기
            sleep 1
        fi
        
        RESULT=$(speedtest-cli --simple 2>/dev/null)
        
        # [핵심 원복] 측정이 끝나면 유선 이더넷 서비스를 즉시 다시 활성화합니다.
        if [ "$ETHER_WAS_ACTIVE" -eq 1 ]; then
            networksetup -setnetworkserviceenabled "$ETHER_SERVICE" on &>/dev/null
        fi
        TARGET_NAME="무선 와이파이 (Wi-Fi)"
        ;;
        
    *)
        echo " ❌ 오류: 잘못된 번호입니다. 1번 또는 2번을 입력해 주세요."
        echo "============================================================"
        exit 1
        ;;
esac

# 4. 결과 출력
echo "------------------------------------------------------------"
if [ -z "$RESULT" ]; then
    echo " ❌ 측정 실패: 네트워크 응답이 없거나 테스트 서버에 연결할 수 없습니다."
    echo " 💡 팁: 현재 선택한 회선으로 실제 인터넷 서핑이 가능한 상태인지 확인해 보세요."
else
    PING=$(echo "$RESULT" | awk '/Ping:/ {print $2 " " $3}')
    DL=$(echo "$RESULT" | awk '/Download:/ {print $2 " Mbps"}')
    UL=$(echo "$RESULT" | awk '/Upload:/ {print $2 " Mbps"}')
    
    echo "  📊 [ ${TARGET_NAME} 측정 결과 ]"
    echo "------------------------------------------------------------"
    printf "  %-12s : %s\n" "지연 시간(Ping)" "$PING"
    printf "  %-12s : %s\n" "다운로드 속도" "$DL"
    printf "  %-12s : %s\n" "업로드 속도" "$UL"
fi
echo "============================================================"
