#!/bin/bash

echo "============================================================"
echo "          나만의 네트워크 도구 전체 복구 시작"
echo "============================================================"

# 1. 현재 디렉토리에 백업 파일이 있는지 확인
BACKUP_FILE=$(ls network_tools_backup_*.tar.gz 2>/dev/null | head -n 1)

if [ -z "$BACKUP_FILE" ]; then
    echo ""
    echo " ❌ 오류: 현재 디렉토리에 'network_tools_backup_*.tar.gz' 파일이 없습니다."
    echo " 💡 해결 방법: 백업 압축 파일이 있는 폴더로 이동한 뒤 다시 실행하세요."
    echo "============================================================"
    exit 1
fi

echo " 📦 발견된 백업 파일: $BACKUP_FILE"
echo " ⚙️ 복구를 진행합니다..."
echo "------------------------------------------------------------"

# 2. 도구 폴더 생성 및 압축 해제 (기존 파일이 있다면 덮어씀)
TARGET_DIR="$HOME/bin/network-tools"
mkdir -p "$TARGET_DIR"
tar -xzf "$BACKUP_FILE" -C "$TARGET_DIR"

# 3. 환경 변수 및 단축키(alias) 중복 체크 후 복원
if [ -f "$TARGET_DIR/zshrc_setting.txt" ]; then
    # 기존 .zshrc에 이미 동일한 설정이 등록되어 있는지 확인 후, 없을 때만 추가
    if ! grep -q "network-tools" "$HOME/.zshrc" 2>/dev/null; then
        cat "$TARGET_DIR/zshrc_setting.txt" >> "$HOME/.zshrc"
        echo " ✅ 터미널 환경 설정(~/.zshrc) 등록 완료"
    else
        echo " ℹ️ 터미널 환경 설정이 이미 존재하므로 건너뜁니다."
    fi
fi

# 4. 실행 권한 보장
chmod +x "$TARGET_DIR/netinfo" 2>/dev/null
chmod +x "$TARGET_DIR/netscan" 2>/dev/null
chmod +x "$TARGET_DIR/restore" 2>/dev/null

echo "------------------------------------------------------------"
echo " ✨ 복구가 성공적으로 완료되었습니다!"
echo " 💡 새로운 터미널 창을 열거나 아래 명령어를 입력하여 적용하세요:"
echo "    source ~/.zshrc"
echo " 💡 복구 후 'netman'을 치면 매뉴얼을 볼 수 있습니다."
echo "============================================================"
